<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema do app depois da splash -->
    <style name="Theme.SalaAutomatizada" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema usado enquanto o app abre (splash do sistema) -->
    <style name="Theme.SalaAutomatizada.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SalaAutomatizada</item>
    </style>
</resources>
